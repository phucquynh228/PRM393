{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HRM: Prepare USB",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/android/prepare.ps1", "-Target", "usb", "-StartBackend"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "HRM: Prepare Emulator",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/android/prepare.ps1", "-Target", "emulator", "-StartEmulator", "-StartBackend"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "HRM: Prepare Android",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/android/prepare.ps1", "-StartEmulator", "-StartBackend"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"},
      "runOptions": {"instanceLimit": 1}
    }
  ]
}
